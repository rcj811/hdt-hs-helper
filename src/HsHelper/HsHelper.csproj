<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HsHelper</AssemblyName>
    <RootNamespace>HsHelper</RootNamespace>
    <Version>0.7.1</Version>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- HDT 的參考檔由 scripts/fetch-hdt-refs.ps1 從官方發行版下載到這裡，不放進 repo -->
    <HdtRefDir Condition="'$(HdtRefDir)' == ''">$(MSBuildThisFileDirectory)..\..\hdt-ref\</HdtRefDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtRefDir)HearthstoneDeckTracker.exe</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HdtRefDir)HearthMirror.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtRefDir)HearthDb.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- 模擬器產生的初始學習資料，內建在 DLL 裡，第一次啟動時自動匯入 -->
    <EmbeddedResource Include="Resources\learning-seed.json" LogicalName="HsHelper.learning-seed.json" Condition="Exists('Resources\learning-seed.json')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
